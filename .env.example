# Copy to .env (setup does this) and fill in only what you use. .env is gitignored - never commit real keys.

# Hugging Face (https://huggingface.co/settings/tokens) - fine-grained, "Inference Providers" + "Read public gated repos"
HF_TOKEN=

# Vultr (https://my.vultr.com/settings/#settingsapi) - can spend your balance; regenerate if exposed
VULTR_API_KEY=

# Optional overrides
# HYPERFRAMES_BROWSER_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# HF_HOME=models/hf
